      "refresh_period": 60,
      "sort_key": "quoteVolume"
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 10
    }
  ],
  "position_adjustment": "adjust",
  "process_only_new_candles": true,
  "reduce_df_footprint": false,
  "stake_amount": "unlimited",
  "stake_currency": "USDT",
  "startup_candle": [
    200,
    400
  ],
  "stoploss": -0.1,
  "targeted_trade_amount": 20,

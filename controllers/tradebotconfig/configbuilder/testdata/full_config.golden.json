    "order_book_top": 1,
    "price_last_balance": 0,
    "price_side": "same",
    "use_order_book": true
  },
  "exchange": {
    "ccxt_config": {
      "enableRateLimit": true
    },
    "enable_ws": true,
    "key": "test-api-key",
    "log_responses": false,
    "markets_refresh_interval": 60,
    "name": "binance",
    "outdated_offset": 5,
    "pair_blacklist": [
      "SCAM/USDT"
    ],
    "pair_whitelist": [
      "BTC/USDT",
      "ETH/USDT"
    ],
    "secret": "test-api-secret",
    "unknown_fee_rate": false
  },
  "exit_pricing": {
    "order_book_top": 1,
    "price_side": "other",
    "use_order_book": true
  },
  "exit_profit_offset": 0.01,
  "exit_profit_only": true,
  "experimental": {
    "block_bad_exchanges": true
  },
  "export": "trades",
  "fee": 0.001,
  "fiat_display_currency": "USD",
  "force_entry_enable": false,
  "freqai": {
    "activate_tensorboard": false,
    "backtest_period_days": 7,
    "continual_learning": false,
    "conv_width": 2,
    "data_kitchen_thread_count": 4,
    "data_split_parameters": {
      "random_state": 42,
      "shuffle": false,
      "test_size": 0.25
    },
    "enabled": true,
    "expiration_hours": 1,
    "feature_parameters": {
      "DI_threshold": 0.5,
      "buffer_train_data_candles": 5,
      "include_corr_pairlist": [
        "BTC/USDT",
        "ETH/USDT"
      ],
      "include_shifted_candles": 2,
      "include_timeframes": [
        "5m",
        "15m"
      ],
      "indicator_periods_candles": [
        10,
        20
      ],
      "label_period_candles": 20,
      "plot_feature_importances": 1,
      "principal_component_analysis": false,
      "shuffle_after_split": false,
      "svm_params": {
        "nu": 0.1,
        "shuffle": true
      },
      "use_SVM_to_remove_outliers": true,
      "weight_factor": 0.9
    },
    "fit_live_predictions_candles": 100,
    "identifier": "freqai-model",
    "keras": false,
    "live_retrain_hours": 0,
    "model_training_parameters": {},
    "purge_old_models": 2,
    "rl_config": {
      "add_state_info": true,
      "cpu_count": 4,
      "drop_ohlc_from_features": false,
      "max_trade_duration_candles": 300,
      "max_training_drawdown_pct": 0.8,
      "model_reward_parameters": {
        "profit_aim": 0.02,
        "rr": 1
      },
      "model_type": "PPO",
      "net_arch": [
        128,
        128
      ],
      "policy_type": "MlpPolicy",
      "progress_bar": true,
      "randomize_starting_position": true,
      "train_cycles": 10
    },
    "save_backtest_models": true,
    "train_period_days": 30,
    "wait_for_training_iteration_on_reload": true,
    "write_metrics_to_disk": true
  },
  "ignore_buying_expired_candle_after": 300,
  "ignore_roi_if_entry_signal": true,
  "initial_state": "running",
  "internals": {
    "interval": 60,
    "process_throttle_secs": 5,
    "sd_notify": false

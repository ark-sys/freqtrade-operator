    "0": 0.1
  },
  "minimum_trade_amount": 10,
  "new_pairs_days": 60,
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "order_types": {
    "emergency_exit": "market",
    "entry": "limit",
    "exit": "limit",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false,
    "stoploss_on_exchange_interval": 60,
    "stoploss_on_exchange_limit_ratio": 0.99
  },
  "orderflow": {
    "cache_size": 1000,
    "imbalance_ratio": 3,
    "imbalance_volume": 1,
    "max_candles": 1500,
    "scale": 0.5,
    "stacked_imbalance_range": 3

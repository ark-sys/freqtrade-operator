{
  "amend_last_stake_amount": true,
  "amount_reserve_percent": 0.05,
  "api_server": {
    "CORS_origins": [
      "http://localhost:8080",
      "https://full-bot.frequi.example.com"
    ],
    "enable_openapi": false,
    "enabled": true,
    "jwt_secret_key": "test-jwt-secret-well-over-the-minimum-length",
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "password": "test-password",
    "username": "test-user",
    "verbosity": "error"
  },
  "available_capital": 10000,
  "backtest_breakdown": [
    "day",
    "week"
  ],
  "bot_name": "my-bot",
  "cancel_open_orders_on_exit": true,
  "custom_price_max_distance_ratio": 0.02,
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "jsongz",
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.sqlite",
  "disable_dataframe_checks": false,
  "disableparamexport": false,
  "discord": {
    "enabled": true,
    "entry_fill": [
      {
        "Trade ID": "{trade_id}"
      }
    ],
    "exit_fill": [
      {
        "Trade ID": "{trade_id}"
      }
    ],
    "webhook_url": "https://discord.example.com/webhook"
  },
  "download_trades": false,
  "dry_run": true,
  "dry_run_wallet": 1000,
  "entry_pricing": {
    "check_depth_of_market": {
      "bids_to_ask_delta": 1,
      "enabled": true

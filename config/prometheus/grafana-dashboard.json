{
  "title": "Freqtrade Operator",
  "uid": "freqtrade-operator",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "TradeBots by phase",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "freqtrade_operator_tradebots",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Bots with config drift (Manual mode, not yet restarted)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "freqtrade_operator_config_drift == 1",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": true },
            "renameByName": { "namespace": "Namespace", "tradebot": "TradeBot" }
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Reconcile errors by controller and reason",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (controller, reason) (rate(freqtrade_operator_reconcile_errors_total[5m]))",
          "legendFormat": "{{controller}} / {{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Config render duration",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(freqtrade_operator_config_render_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(freqtrade_operator_config_render_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(freqtrade_operator_config_render_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 5,
      "title": "Row",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "title": "Per-bot P&L (P4-3)",
      "type": "table",
      "description": "One row per bot currently reachable. dry_run bots show real numbers too - they just never touch real money.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "targets": [
        { "expr": "freqtrade_bot_up", "format": "table", "instant": true, "refId": "up" },
        { "expr": "freqtrade_bot_open_trades", "format": "table", "instant": true, "refId": "open_trades" },
        { "expr": "freqtrade_bot_max_open_trades", "format": "table", "instant": true, "refId": "max_open_trades" },
        { "expr": "freqtrade_bot_profit_abs", "format": "table", "instant": true, "refId": "profit_abs" },
        { "expr": "freqtrade_bot_profit_ratio", "format": "table", "instant": true, "refId": "profit_ratio" },
        { "expr": "freqtrade_bot_balance", "format": "table", "instant": true, "refId": "balance" }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "tradebot", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true },
            "renameByName": {
              "namespace": "Namespace",
              "tradebot": "TradeBot",
              "strategy": "Strategy",
              "exchange": "Exchange",
              "dry_run": "Dry run",
              "Value #up": "Up",
              "Value #open_trades": "Open trades",
              "Value #max_open_trades": "Max open trades",
              "Value #profit_abs": "Profit (abs)",
              "Value #profit_ratio": "Profit (ratio)",
              "Value #balance": "Balance"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Per-bot profit over time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "targets": [
        {
          "expr": "freqtrade_bot_profit_abs",
          "legendFormat": "{{namespace}}/{{tradebot}}",
          "refId": "A"
        }
      ]
    }
  ]
}
